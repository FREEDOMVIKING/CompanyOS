#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
cd "${HOME}/companyos"
CMD="${1:-status}"
case "$CMD" in
  start) python -m companyos.controlplane.cli start ;;
  stop) python -m companyos.controlplane.cli stop ;;
  restart) python -m companyos.controlplane.cli restart ;;
  status) python -m companyos.controlplane.cli status ;;
  once) python -m companyos.controlplane.cli once ;;
  logs) tail -f "${HOME}/companyos/logs/controlplane.log" ;;
  test) python -m unittest discover -s tests_phase18301_18400 -v ;;
  *) echo "Usage: bash companyosctl {start|stop|restart|status|once|logs|test}"; exit 2 ;;
esac
