#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"
RUN="$ROOT/.companyos_runtime"
PID="$RUN/autonomous_launch_director_v36.pid"
LOG="$RUN/autonomous_launch_director_v36.log"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
mkdir -p "$RUN"

case "${1:-status}" in
 start)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Autonomous Launch Director V36 already running (PID $(cat "$PID"))"
    exit 0
  fi
  cd "$ROOT"
  nohup python -u -m companyos.autonomous_launch_director_v36.server >"$LOG" 2>&1 &
  echo $! >"$PID"
  sleep 2
  if kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Autonomous Launch Director V36 started (PID $(cat "$PID"))"
    echo "Dashboard: http://127.0.0.1:8798"
  else
    echo "Failed to start V36"
    tail -80 "$LOG" 2>/dev/null || true
    exit 1
  fi ;;
 stop)
  [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true
  rm -f "$PID"
  pkill -f 'companyos\.autonomous_launch_director_v36\.server' 2>/dev/null || true
  echo "Autonomous Launch Director V36 stopped" ;;
 restart)
  bash "$SELF" stop
  sleep 2
  bash "$SELF" start ;;
 status)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Autonomous Launch Director V36: RUNNING (PID $(cat "$PID"))"
  else
    echo "Autonomous Launch Director V36: STOPPED"
  fi
  curl --max-time 10 -s http://127.0.0.1:8798/api/status || true
  echo ;;
 logs)
  tail -100 "$LOG" 2>/dev/null || true ;;
 *)
  echo "Usage: $0 {start|stop|restart|status|logs}"
  exit 2 ;;
esac
