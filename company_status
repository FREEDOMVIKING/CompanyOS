#!/usr/bin/env python3

import json
from pathlib import Path
from typing import Any

ROOT_DIR = Path(__file__).resolve().parent.parent
MEMORY_DIR = ROOT_DIR / "ceo_memory"


def load_json(
    filename: str,
    default: Any,
) -> Any:
    try:
        return json.loads(
            (MEMORY_DIR / filename)
            .read_text(encoding="utf-8")
        )
    except Exception:
        return default


authority = load_json(
    "authority_state.json",
    {},
)

supervisor = load_json(
    "supervisor_state.json",
    {},
)

autopilot = load_json(
    "autopilot_state.json",
    {},
)

pipeline = load_json(
    "autonomous_business_pipeline_summary.json",
    {},
)

opportunities = load_json(
    "opportunities.json",
    [],
)

validations = load_json(
    "opportunity_validations.json",
    [],
)

workflows = load_json(
    "product_factory_workflows.json",
    [],
)

products = load_json(
    "products.json",
    [],
)

listings = load_json(
    "marketplace_listings.json",
    [],
)


def count(value: Any) -> int:
    if isinstance(value, (list, dict)):
        return len(value)

    return 0


status = {
    "success": True,
    "status": "companyos_status",
    "authority_mode": authority.get("mode"),
    "supervisor_running": supervisor.get(
        "running",
        False,
    ),
    "supervisor_pid": supervisor.get("pid"),
    "autopilot_running": autopilot.get(
        "running",
        False,
    ),
    "autopilot_pid": autopilot.get("pid"),
    "last_ceo_cycle_success": autopilot.get(
        "last_cycle_success"
    ),
    "last_ceo_cycle_completed_at": autopilot.get(
        "last_cycle_completed_at"
    ),
    "latest_pipeline_status": pipeline.get(
        "status"
    ),
    "pipeline_failure_count": pipeline.get(
        "failed_stage_count",
        0,
    ),
    "portfolio": {
        "opportunities": count(opportunities),
        "validations": count(validations),
        "workflows": count(workflows),
        "products": count(products),
        "listings": count(listings),
    },
    "recovery": {
        "restart_count_this_hour": supervisor.get(
            "restart_count_this_hour",
            0,
        ),
        "total_restart_count": supervisor.get(
            "total_restart_count",
            0,
        ),
        "last_restart_at": supervisor.get(
            "last_restart_at"
        ),
        "last_error": supervisor.get(
            "last_error"
        ),
    },
}

print(json.dumps(status, indent=2))
