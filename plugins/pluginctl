#!/usr/bin/env python3

import argparse
import json

from runtime import (
    discover_plugins,
    health_check,
    health_check_all,
    list_plugins,
    set_enabled,
)


def print_json(data) -> None:
    print(json.dumps(data, indent=2))


def main() -> None:
    parser = argparse.ArgumentParser(
        description="CompanyOS plugin manager"
    )

    subparsers = parser.add_subparsers(
        dest="command",
        required=True,
    )

    subparsers.add_parser("discover")
    subparsers.add_parser("list")
    subparsers.add_parser("health-all")

    health_parser = subparsers.add_parser("health")
    health_parser.add_argument("plugin_id")

    enable_parser = subparsers.add_parser("enable")
    enable_parser.add_argument("plugin_id")

    disable_parser = subparsers.add_parser("disable")
    disable_parser.add_argument("plugin_id")

    args = parser.parse_args()

    if args.command == "discover":
        print_json(discover_plugins())
    elif args.command == "list":
        print_json(list_plugins())
    elif args.command == "health":
        print_json(health_check(args.plugin_id))
    elif args.command == "health-all":
        print_json(health_check_all())
    elif args.command == "enable":
        print_json(set_enabled(args.plugin_id, True))
    elif args.command == "disable":
        print_json(set_enabled(args.plugin_id, False))


if __name__ == "__main__":
    main()
