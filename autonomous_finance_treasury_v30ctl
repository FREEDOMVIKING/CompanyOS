#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"; RUN="$ROOT/.companyos_runtime"; PID="$RUN/autonomous_finance_treasury_v30.pid"; LOG="$RUN/autonomous_finance_treasury_v30.log"
mkdir -p "$RUN"
case "${1:-status}" in
 start)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then echo "Autonomous Finance & Treasury V30 already running (PID $(cat "$PID"))"; exit 0; fi
  cd "$ROOT"; nohup python -u -m companyos.autonomous_finance_treasury_v30.server >"$LOG" 2>&1 & echo $! >"$PID"; sleep 2
  kill -0 "$(cat "$PID")" 2>/dev/null && echo "Autonomous Finance & Treasury V30 started (PID $(cat "$PID"))" || { tail -80 "$LOG"; exit 1; };;
 stop) [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true; rm -f "$PID"; pkill -f 'companyos\.autonomous_finance_treasury_v30\.server' 2>/dev/null || true; echo "Autonomous Finance & Treasury V30 stopped";;
 restart) "$0" stop; sleep 2; "$0" start;;
 status) [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && echo "Autonomous Finance & Treasury V30: RUNNING (PID $(cat "$PID"))" || echo "Autonomous Finance & Treasury V30: STOPPED"; curl --max-time 10 -s http://127.0.0.1:8792/api/status || true; echo;;
 logs) tail -100 "$LOG" 2>/dev/null || true;;
 *) echo "Usage: $0 {start|stop|restart|status|logs}"; exit 2;;
esac
