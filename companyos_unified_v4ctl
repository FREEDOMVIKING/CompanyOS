#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"
RUN="$ROOT/.companyos_unified_v4"
PID="$RUN/companyos_unified_v4.pid"
LOG="$RUN/companyos_unified_v4.log"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
mkdir -p "$RUN"

case "${1:-status}" in
 start)
   [ -x "$ROOT/companyos_unified_v3ctl" ] && bash "$ROOT/companyos_unified_v3ctl" stop >/dev/null 2>&1 || true
   if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then echo "CompanyOS Unified Core V4 already running (PID $(cat "$PID"))"; exit 0; fi
   cd "$ROOT"; nohup python -u -m companyos.unified_core_v4.server >"$LOG" 2>&1 & echo $! >"$PID"; sleep 3
   if kill -0 "$(cat "$PID")" 2>/dev/null; then echo "CompanyOS Unified Core V4 started (PID $(cat "$PID"))"; echo "Dashboard: http://127.0.0.1:9000"
   else echo "Failed to start V4"; tail -140 "$LOG" 2>/dev/null || true; rm -f "$PID"; exit 1; fi ;;
 stop)
   [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true; rm -f "$PID"
   pkill -f 'companyos\.unified_core_v4\.server' 2>/dev/null || true; echo "CompanyOS Unified Core V4 stopped" ;;
 restart) bash "$SELF" stop; sleep 2; bash "$SELF" start ;;
 status)
   if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then echo "CompanyOS Unified Core V4: RUNNING (PID $(cat "$PID"))"; else echo "CompanyOS Unified Core V4: STOPPED"; fi
   curl --max-time 10 -s http://127.0.0.1:9000/api/status || true; echo ;;
 cycle) curl --max-time 30 -s http://127.0.0.1:9000/api/cycle || true; echo ;;
 migrate) curl --max-time 30 -s http://127.0.0.1:9000/api/migrate || true; echo ;;
 logs) tail -200 "$LOG" 2>/dev/null || true ;;
 *) echo "Usage: $0 {start|stop|restart|status|cycle|migrate|logs}"; exit 2 ;;
esac
