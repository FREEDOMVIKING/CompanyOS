#!/usr/bin/env python3

import json
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT_DIR))

from agents.executive_strategy_agent import (
    run_executive_strategy_cycle,
    status,
)


def main() -> int:
    command = (
        sys.argv[1].strip().lower()
        if len(sys.argv) > 1
        else "status"
    )

    if command == "status":
        result = status()

    elif command in {
        "run",
        "plan",
        "review",
    }:
        result = run_executive_strategy_cycle()

    else:
        raise SystemExit(
            "Usage: strategyctl {status|run}"
        )

    print(json.dumps(result, indent=2))

    return (
        0
        if result.get("success") is not False
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(main())
