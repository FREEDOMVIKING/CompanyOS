#!/data/data/com.termux/files/usr/bin/bash

ROOT="$HOME/companyos"
PIDFILE="$ROOT/run/autonomous_operations.pid"
LOG="$ROOT/logs/phone_watchdog.log"

mkdir -p "$ROOT/run" "$ROOT/logs"

echo "$(date -Iseconds) watchdog started" >> "$LOG"

while true; do
    ALIVE=0

    if [ -f "$PIDFILE" ]; then
        PID="$(cat "$PIDFILE" 2>/dev/null)"

        if [ -n "$PID" ] && kill -0 "$PID" 2>/dev/null; then
            ALIVE=1
        fi
    fi

    if [ "$ALIVE" -eq 0 ]; then
        echo "$(date -Iseconds) scheduler missing - restarting" >> "$LOG"

        cd "$ROOT" || exit 1
        python agents/autonomous_operations_scheduler.py start >> "$LOG" 2>&1

        sleep 15
    fi

    sleep 60
done
