#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"
RUN="$ROOT/.companyos_enterprise_v9"
PID="$RUN/pid"
LOG="$RUN/v9.log"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
mkdir -p "$RUN"

case "${1:-status}" in
 start)
   [ -x "$ROOT/companyos_enterprise_v8ctl" ] && bash "$ROOT/companyos_enterprise_v8ctl" stop >/dev/null 2>&1 || true
   if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
     echo "V9 already running (PID $(cat "$PID"))"; exit 0
   fi
   cd "$ROOT"
   nohup python -u -m companyos.autonomous_enterprise_expansion_v9.server >"$LOG" 2>&1 &
   echo $! >"$PID"
   sleep 3
   if kill -0 "$(cat "$PID")" 2>/dev/null; then
     echo "V9 started (PID $(cat "$PID"))"
     echo "Dashboard: http://127.0.0.1:9000"
   else
     echo "V9 failed to start"
     tail -160 "$LOG" 2>/dev/null || true
     exit 1
   fi ;;
 stop)
   [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true
   rm -f "$PID"
   pkill -f 'companyos\.autonomous_enterprise_expansion_v9\.server' 2>/dev/null || true
   echo "V9 stopped" ;;
 restart) bash "$SELF" stop; sleep 2; bash "$SELF" start ;;
 status)
   [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && echo "V9 RUNNING (PID $(cat "$PID"))" || echo "V9 STOPPED"
   curl --max-time 10 -s http://127.0.0.1:9000/api/status || true
   echo ;;
 cycle) curl --max-time 30 -s http://127.0.0.1:9000/api/cycle || true; echo ;;
 migrate) curl --max-time 30 -s http://127.0.0.1:9000/api/migrate || true; echo ;;
 seed-opportunity)
   cat > "$RUN/opportunities_inbox.json" <<'JSON'
{
  "opportunities": [
    {
      "name": "AI Proposal Generator for Small Contractors",
      "category": "software",
      "demand_score": 88,
      "margin_score": 91,
      "execution_score": 82,
      "strategic_fit": 90
    }
  ]
}
JSON
   echo "Opportunity seed written."
   echo "Run: bash companyos_enterprise_v9ctl cycle" ;;
 backup)
   cd "$ROOT"
   mkdir -p backups
   S="$(date +%Y%m%d_%H%M%S)"
   tar -czf "backups/companyos_v9_$S.tar.gz" .companyos_enterprise_v9 companyos/autonomous_enterprise_expansion_v9 companyos_enterprise_v9ctl 2>/dev/null || true
   echo "Backup: $ROOT/backups/companyos_v9_$S.tar.gz" ;;
 logs) tail -240 "$LOG" 2>/dev/null || true ;;
 *) echo "Usage: $0 {start|stop|restart|status|cycle|migrate|seed-opportunity|backup|logs}"; exit 2 ;;
esac
