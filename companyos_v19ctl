#!/usr/bin/env python3
import json,sys
from pathlib import Path
sys.path.insert(0,str(Path.home()/"companyos"))
from companyos.adaptive_provider_discovery_v19.discovery import discover,build,validate
c=sys.argv[1] if len(sys.argv)>1 else "status"
f={"status":discover,"build-config":build,"validate":validate}.get(c)
if not f: raise SystemExit("usage: companyos_v19ctl {status|build-config|validate}")
print(json.dumps(f(),indent=2))
