from __future__ import annotations

from pathlib import Path

import base64
import hashlib
import os
import shutil
import struct
import subprocess
import tempfile
from dataclasses import dataclass

from companyos.walletintegration.adaptive_solana_key import b58decode
from companyos.walletintegration.solana_signer_key_adapter import load_signer_material


SYSTEM_PROGRAM = "11111111111111111111111111111111"


def shortvec(n: int) -> bytes:
    if n < 0:
        raise ValueError("negative_shortvec")
    out = bytearray()
    while True:
        elem = n & 0x7F
        n >>= 7
        if n:
            elem |= 0x80
        out.append(elem)
        if not n:
            return bytes(out)


@dataclass(frozen=True)
class BuiltSignedTransaction:
    wallet_address: str
    recent_blockhash: str
    message_bytes: bytes
    signature_bytes: bytes
    transaction_bytes: bytes
    transaction_base64: str
    message_sha256: str
    transaction_sha256: str
    signature_verified: bool
    lamports: int
    destination: str


def _openssl_sign_and_verify(seed: bytes, pub: bytes, message: bytes) -> tuple[bytes, bool]:
    openssl = shutil.which("openssl")
    if not openssl:
        raise RuntimeError("openssl_not_found")

    priv_der = bytes.fromhex("302e020100300506032b657004220420") + seed
    pub_der = bytes.fromhex("302a300506032b6570032100") + pub

    with tempfile.TemporaryDirectory(prefix="companyos_phase78_") as td:
        priv = os.path.join(td, "priv.der")
        pubf = os.path.join(td, "pub.der")
        msg = os.path.join(td, "msg.bin")
        sig = os.path.join(td, "sig.bin")

        fd = os.open(priv, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        try:
            os.write(fd, priv_der)
        finally:
            os.close(fd)

        Path(pubf).write_bytes(pub_der)
        Path(msg).write_bytes(message)

        sign = subprocess.run(
            [openssl, "pkeyutl", "-sign", "-rawin", "-inkey", priv, "-keyform", "DER",
             "-in", msg, "-out", sig],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=30
        )
        if sign.returncode != 0:
            raise RuntimeError("openssl_sign_failed:" + sign.stderr.decode(errors="ignore")[:240])

        sig_bytes = Path(sig).read_bytes()

        verify = subprocess.run(
            [openssl, "pkeyutl", "-verify", "-rawin", "-pubin", "-inkey", pubf, "-keyform", "DER",
             "-in", msg, "-sigfile", sig],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False, timeout=30
        )
        return sig_bytes, verify.returncode == 0


def build_zero_lamport_self_transfer(secret: str, encoding: str, recent_blockhash: str) -> BuiltSignedTransaction:
    """
    Build a real Solana LEGACY transaction message for:
      SystemProgram.transfer(source=wallet, destination=wallet, lamports=0)

    The transaction is signed and serialized locally.
    It is NOT broadcast or simulated by this module.
    """
    material = load_signer_material(secret, encoding)
    if material.key_length != 64:
        raise RuntimeError("phase78_requires_64_byte_exported_secret")
    if not material.public_address:
        raise RuntimeError("public_address_unavailable")

    seed = material.secret_bytes[:32]
    pub = material.secret_bytes[32:64]

    payer = pub
    system_program = b58decode(SYSTEM_PROGRAM)
    blockhash = b58decode(recent_blockhash)

    if len(payer) != 32 or len(system_program) != 32 or len(blockhash) != 32:
        raise ValueError("invalid_32_byte_pubkey_or_blockhash")

    # Legacy Message header:
    # 1 required signer, 0 readonly signed, 1 readonly unsigned (system program)
    header = bytes([1, 0, 1])

    # Accounts: payer/wallet, system program.
    account_keys = shortvec(2) + payer + system_program

    # System transfer instruction:
    # u32 little-endian instruction discriminator 2 + u64 lamports.
    data = struct.pack("<IQ", 2, 0)

    # program_id_index = 1 (system program)
    # account indices [0, 0] => source and destination are same wallet
    instruction = (
        bytes([1]) +
        shortvec(2) + bytes([0, 0]) +
        shortvec(len(data)) + data
    )

    message = (
        header +
        account_keys +
        blockhash +
        shortvec(1) +
        instruction
    )

    signature, verified = _openssl_sign_and_verify(seed, pub, message)
    if len(signature) != 64:
        raise RuntimeError(f"unexpected_signature_length:{len(signature)}")

    transaction = shortvec(1) + signature + message

    return BuiltSignedTransaction(
        wallet_address=material.public_address,
        recent_blockhash=recent_blockhash,
        message_bytes=message,
        signature_bytes=signature,
        transaction_bytes=transaction,
        transaction_base64=base64.b64encode(transaction).decode("ascii"),
        message_sha256=hashlib.sha256(message).hexdigest(),
        transaction_sha256=hashlib.sha256(transaction).hexdigest(),
        signature_verified=verified,
        lamports=0,
        destination=material.public_address,
    )
