#!/usr/bin/env python3

from pathlib import Path
import subprocess
import sys


ROOT = Path.home() / "companyos"
SCORER = ROOT / "agents" / "opportunity_scorer.py"


def main() -> int:
    if not SCORER.exists():
        print("Opportunity Scoring Engine is not installed.")
        return 1

    return subprocess.call(
        [sys.executable, str(SCORER), *sys.argv[1:]],
        cwd=ROOT,
    )


if __name__ == "__main__":
    raise SystemExit(main())
