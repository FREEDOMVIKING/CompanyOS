#!/usr/bin/env python3

import argparse
import subprocess
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent


def main() -> None:
    parser = argparse.ArgumentParser(
        description="CompanyOS Executive Dashboard"
    )

    parser.add_argument(
        "command",
        choices=[
            "start",
            "stop",
            "status",
        ],
    )

    args = parser.parse_args()

    script = (
        ROOT_DIR
        / "companyos"
        / "dashboard"
        / f"{args.command}.sh"
    )

    raise SystemExit(
        subprocess.run(
            ["bash", str(script)],
            cwd=str(ROOT_DIR),
        ).returncode
    )


if __name__ == "__main__":
    main()
