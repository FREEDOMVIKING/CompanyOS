#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

ROOT="$HOME/companyos"
RUN="$ROOT/.companyos_unified_v2"
PID="$RUN/companyos_unified_v2.pid"
LOG="$RUN/companyos_unified_v2.log"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
mkdir -p "$RUN"

case "${1:-status}" in
  start)
    if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
      echo "CompanyOS Unified Core V2 already running (PID $(cat "$PID"))"
      exit 0
    fi
    cd "$ROOT"
    nohup python -u -m companyos.unified_core_v2.server >"$LOG" 2>&1 &
    echo $! >"$PID"
    sleep 3
    if kill -0 "$(cat "$PID")" 2>/dev/null; then
      echo "CompanyOS Unified Core V2 started (PID $(cat "$PID"))"
      echo "Dashboard: http://127.0.0.1:9000"
    else
      echo "Failed to start CompanyOS Unified Core V2"
      tail -120 "$LOG" 2>/dev/null || true
      rm -f "$PID"
      exit 1
    fi
    ;;
  stop)
    if [ -f "$PID" ]; then
      kill "$(cat "$PID")" 2>/dev/null || true
      rm -f "$PID"
    fi
    pkill -f 'companyos\.unified_core_v2\.server' 2>/dev/null || true
    echo "CompanyOS Unified Core V2 stopped"
    ;;
  restart)
    bash "$SELF" stop
    sleep 2
    bash "$SELF" start
    ;;
  status)
    if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
      echo "CompanyOS Unified Core V2: RUNNING (PID $(cat "$PID"))"
    else
      echo "CompanyOS Unified Core V2: STOPPED"
    fi
    curl --max-time 10 -s http://127.0.0.1:9000/api/status || true
    echo
    ;;
  migrate)
    cd "$ROOT"
    python - <<'PY'
from pathlib import Path
from companyos.unified_core_v2.core import UnifiedCore
import json
c=UnifiedCore(Path.home()/"companyos")
print(json.dumps(c.migrate(),indent=2))
PY
    ;;
  cycle)
    cd "$ROOT"
    python - <<'PY'
from pathlib import Path
from companyos.unified_core_v2.core import UnifiedCore
import json
c=UnifiedCore(Path.home()/"companyos")
print(json.dumps(c.run_cycle(),indent=2))
PY
    ;;
  legacy-audit)
    cd "$ROOT"
    echo "=== CompanyOS legacy controllers ==="
    ls -1 *ctl 2>/dev/null | sort || true
    echo
    echo "=== Legacy live state files ==="
    find .companyos_runtime -maxdepth 1 -type f -name '*.json' -printf '%f\n' 2>/dev/null | sort || true
    ;;
  logs)
    tail -160 "$LOG" 2>/dev/null || true
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|migrate|cycle|legacy-audit|logs}"
    exit 2
    ;;
esac
