#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"
RUN="$ROOT/.companyos_runtime"
PID="$RUN/command_center_v25.pid"
LOG="$RUN/command_center_v25.log"
mkdir -p "$RUN"

case "${1:-status}" in
 start)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Command Center V25 already running (PID $(cat "$PID"))"
    exit 0
  fi
  cd "$ROOT"
  nohup python -u -m companyos.command_center_v25.server >"$LOG" 2>&1 &
  echo $! >"$PID"
  sleep 2
  if kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Command Center V25 started (PID $(cat "$PID"))"
    echo "Dashboard: http://127.0.0.1:8787"
  else
    echo "Failed to start"
    tail -80 "$LOG" 2>/dev/null || true
    exit 1
  fi ;;
 stop)
  [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true
  rm -f "$PID"
  pkill -f 'companyos\.command_center_v25\.server' 2>/dev/null || true
  echo "Command Center V25 stopped" ;;
 restart) "$0" stop; sleep 2; "$0" start ;;
 status)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Command Center V25: RUNNING (PID $(cat "$PID"))"
  else
    echo "Command Center V25: STOPPED"
  fi
  curl --max-time 10 -s http://127.0.0.1:8787/api/status || true
  echo ;;
 logs) tail -100 "$LOG" 2>/dev/null || true ;;
 backup)
  curl --max-time 120 -s http://127.0.0.1:8787/api/backup || true
  echo ;;
 *) echo "Usage: $0 {start|stop|restart|status|logs|backup}"; exit 2 ;;
esac
