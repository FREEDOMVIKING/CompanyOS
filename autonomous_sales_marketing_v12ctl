#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
R="$HOME/companyos"; D="$R/.companyos_runtime"; P="$D/autonomous_sales_marketing_v12.pid"; L="$D/autonomous_sales_marketing_v12.log"; mkdir -p "$D"
case "${1:-status}" in
 start)
  if [ -f "$P" ] && kill -0 "$(cat "$P")" 2>/dev/null; then echo "Already running PID $(cat "$P")"; exit 0; fi
  cd "$R"; nohup python -u -m companyos.autonomous_sales_marketing_v12.server >"$L" 2>&1 & echo $! >"$P"; sleep 2
  kill -0 "$(cat "$P")" 2>/dev/null && echo "Started PID $(cat "$P") — http://127.0.0.1:8774" || { tail -80 "$L"; exit 1; };;
 stop) [ -f "$P" ] && kill "$(cat "$P")" 2>/dev/null || true; rm -f "$P"; pkill -f 'companyos\.autonomous_sales_marketing_v12\.server' 2>/dev/null || true; echo Stopped;;
 restart) "$0" stop; sleep 2; "$0" start;;
 status) [ -f "$P" ] && kill -0 "$(cat "$P")" 2>/dev/null && echo "RUNNING PID $(cat "$P")" || echo STOPPED; curl --max-time 5 -s http://127.0.0.1:8774/api/status || true; echo;;
 logs) tail -100 "$L" 2>/dev/null || true;;
 *) echo "Usage: $0 {start|stop|restart|status|logs}"; exit 2;;
esac
