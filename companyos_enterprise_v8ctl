#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"
RUN="$ROOT/.companyos_enterprise_v8"
PID="$RUN/pid"
LOG="$RUN/v8.log"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
mkdir -p "$RUN"

case "${1:-status}" in
 start)
   [ -x "$ROOT/companyos_enterprise_v7ctl" ] && bash "$ROOT/companyos_enterprise_v7ctl" stop >/dev/null 2>&1 || true
   if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
     echo "V8 already running (PID $(cat "$PID"))"; exit 0
   fi
   cd "$ROOT"
   nohup python -u -m companyos.autonomous_enterprise_os_v8.server >"$LOG" 2>&1 &
   echo $! >"$PID"
   sleep 3
   kill -0 "$(cat "$PID")" 2>/dev/null && echo "V8 started (PID $(cat "$PID")) - http://127.0.0.1:9000" || { tail -120 "$LOG"; exit 1; }
   ;;
 stop)
   [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true
   rm -f "$PID"
   pkill -f 'companyos\.autonomous_enterprise_os_v8\.server' 2>/dev/null || true
   echo "V8 stopped"
   ;;
 restart) bash "$SELF" stop; sleep 2; bash "$SELF" start ;;
 status)
   [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null && echo "V8 RUNNING (PID $(cat "$PID"))" || echo "V8 STOPPED"
   curl --max-time 10 -s http://127.0.0.1:9000/api/status || true
   echo
   ;;
 cycle) curl --max-time 30 -s http://127.0.0.1:9000/api/cycle || true; echo ;;
 migrate)
   bash "$SELF" stop >/dev/null 2>&1 || true
   python "$ROOT/v8_migration_repair.py"
   bash "$SELF" start
   ;;
 logs) tail -200 "$LOG" 2>/dev/null || true ;;
 backup)
   cd "$ROOT"; mkdir -p backups; S="$(date +%Y%m%d_%H%M%S)"
   tar -czf "backups/companyos_v8_$S.tar.gz" .companyos_enterprise_v8 companyos/autonomous_enterprise_os_v8 companyos_enterprise_v8ctl 2>/dev/null || true
   echo "Backup: $ROOT/backups/companyos_v8_$S.tar.gz"
   ;;
 *) echo "Usage: $0 {start|stop|restart|status|cycle|migrate|logs|backup}"; exit 2 ;;
esac
