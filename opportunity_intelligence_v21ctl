#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"
RUN="$ROOT/.companyos_runtime"
PID="$RUN/opportunity_intelligence_v21.pid"
LOG="$RUN/opportunity_intelligence_v21.log"
mkdir -p "$RUN"

case "${1:-status}" in
 start)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Opportunity Intelligence V21 already running (PID $(cat "$PID"))"
    exit 0
  fi
  cd "$ROOT"
  nohup python -u -m companyos.opportunity_intelligence_v21.server >"$LOG" 2>&1 &
  echo $! >"$PID"
  sleep 2
  if kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Opportunity Intelligence V21 started (PID $(cat "$PID"))"
    echo "Dashboard: http://127.0.0.1:8783"
  else
    echo "Failed to start"
    tail -80 "$LOG" 2>/dev/null || true
    exit 1
  fi ;;
 stop)
  [ -f "$PID" ] && kill "$(cat "$PID")" 2>/dev/null || true
  rm -f "$PID"
  pkill -f 'companyos\.opportunity_intelligence_v21\.server' 2>/dev/null || true
  echo "Opportunity Intelligence V21 stopped" ;;
 restart) "$0" stop; sleep 2; "$0" start ;;
 status)
  if [ -f "$PID" ] && kill -0 "$(cat "$PID")" 2>/dev/null; then
    echo "Opportunity Intelligence V21: RUNNING (PID $(cat "$PID"))"
  else
    echo "Opportunity Intelligence V21: STOPPED"
  fi
  curl --max-time 8 -s http://127.0.0.1:8783/api/status || true
  echo ;;
 logs) tail -100 "$LOG" 2>/dev/null || true ;;
 *) echo "Usage: $0 {start|stop|restart|status|logs}"; exit 2 ;;
esac
