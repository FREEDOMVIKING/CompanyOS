#!/usr/bin/env python3

import argparse
import json
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent

if str(ROOT_DIR) not in sys.path:
    sys.path.insert(0, str(ROOT_DIR))

from agents.product_factory_validation_runner import run_task


def main() -> None:
    parser = argparse.ArgumentParser(
        description="CompanyOS Product Factory Validation"
    )

    parser.add_argument(
        "command",
        choices=[
            "run",
            "queue",
            "sync",
            "status",
        ],
    )

    args = parser.parse_args()

    actions = {
        "run": "run_factory_validation_cycle",
        "queue": "queue_factory_validation",
        "sync": "sync_factory_validation",
        "status": "factory_validation_status",
    }

    result = run_task({
        "action": actions[args.command],
    })

    print(json.dumps(result, indent=2))

    if result.get("success") is False:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
