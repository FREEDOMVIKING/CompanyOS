#!/usr/bin/env python3
import json,sys
from pathlib import Path
sys.path.insert(0,str(Path.home()/"companyos"))
from companyos.adaptive_key_bridge_v18.resolver import AdaptiveKeyResolverV18
r=AdaptiveKeyResolverV18(); cmd=sys.argv[1] if len(sys.argv)>1 else "status"
out=r.status() if cmd=="status" else r.build_map() if cmd=="discover" else r.export() if cmd=="export" else None
if out is None: raise SystemExit("usage: adaptive_keys_v18ctl {status|discover|export}")
print(json.dumps(out,indent=2))
