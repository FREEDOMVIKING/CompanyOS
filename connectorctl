#!/usr/bin/env python3

import json
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT_DIR))

from agents.external_connector_manager import (
    check_all_connectors,
    process_external_queue,
    queue_external_action,
    set_connector_enabled,
    status,
)


def main() -> int:
    command = (
        sys.argv[1].strip().lower()
        if len(sys.argv) > 1
        else "status"
    )

    if command == "status":
        result = status()

    elif command == "health":
        result = check_all_connectors()

    elif command == "process":
        result = process_external_queue()

    elif command in {"enable", "disable"}:
        if len(sys.argv) < 3:
            raise SystemExit(
                "Usage: connectorctl enable|disable CONNECTOR_ID"
            )

        result = set_connector_enabled(
            sys.argv[2],
            command == "enable",
        )

    elif command == "queue":
        if len(sys.argv) < 4:
            raise SystemExit(
                "Usage: connectorctl queue "
                "CONNECTOR_ID ACTION [JSON_PAYLOAD]"
            )

        payload = {}

        if len(sys.argv) > 4:
            payload = json.loads(sys.argv[4])

        result = queue_external_action(
            connector_id=sys.argv[2],
            action=sys.argv[3],
            payload=payload,
            reason="Queued through connectorctl",
        )

    else:
        raise SystemExit(
            "Usage: connectorctl "
            "{status|health|process|enable|disable|queue}"
        )

    print(json.dumps(result, indent=2))

    return (
        0
        if result.get("success") is not False
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(main())
