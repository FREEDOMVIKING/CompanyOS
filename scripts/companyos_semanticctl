#!/data/data/com.termux/files/usr/bin/bash
set -e
cd "$HOME/companyos"
case "${1:-status}" in
  once) python -m companyos.runtime.semantic_capability_bridge once ;;
  status) python -m companyos.runtime.semantic_capability_bridge status ;;
  events) tail -n "${2:-40}" .companyos_runtime/capability_expansion/semantic_bridge_events.jsonl 2>/dev/null || true ;;
  *) echo "usage: scripts/companyos_semanticctl {once|status|events [N]}"; exit 2 ;;
esac
