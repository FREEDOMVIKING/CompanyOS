#!/data/data/com.termux/files/usr/bin/bash
set -e
cd "$HOME/companyos"
case "${1:-status}" in
  once) python -m companyos.runtime.evidence_decision_closure once ;;
  status) python -m companyos.runtime.evidence_decision_closure status ;;
  history) python -m companyos.runtime.evidence_decision_closure history ;;
  *) echo "usage: scripts/companyos_decisionctl {once|status|history}"; exit 2 ;;
esac
