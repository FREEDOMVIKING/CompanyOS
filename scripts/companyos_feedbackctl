#!/data/data/com.termux/files/usr/bin/bash
set -e
cd "$HOME/companyos"
case "${1:-status}" in
  once) python -m companyos.runtime.capability_feedback once ;;
  status) python -m companyos.runtime.capability_feedback status ;;
  events) tail -n "${2:-40}" .companyos_runtime/capability_feedback_events.jsonl 2>/dev/null || true ;;
  *) echo "usage: scripts/companyos_feedbackctl {once|status|events [N]}"; exit 2 ;;
esac
