#!/data/data/com.termux/files/usr/bin/bash
set -e
cd "$HOME/companyos"
case "${1:-status}" in
  once) python -m companyos.runtime.autonomous_evidence_acquisition once ;;
  status) python -m companyos.runtime.autonomous_evidence_acquisition status ;;
  queue) python -m companyos.runtime.autonomous_evidence_acquisition queue ;;
  events) tail -n "${2:-50}" .companyos_runtime/evidence_acquisition_events.jsonl 2>/dev/null || true ;;
  *) echo "usage: scripts/companyos_evidencectl {once|status|queue|events [N]}"; exit 2 ;;
esac
