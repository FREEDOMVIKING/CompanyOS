#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
ROOT="$HOME/companyos"
RT="$HOME/.companyos_runtime"
PIDFILE="$RT/advanced_drl.pid"
LOGFILE="$RT/advanced_drl.log"
cd "$ROOT"
export PYTHONPATH="$PWD${PYTHONPATH:+:$PYTHONPATH}"

cmd="${1:-status}"
case "$cmd" in
  start)
    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
      echo "ADVANCED_DRL_ALREADY_RUNNING PID=$(cat "$PIDFILE")"
      exit 0
    fi
    nohup python -m companyos.runtime.advanced_drl_controller loop --interval "${COMPANYOS_DRL_INTERVAL_SECONDS:-900}" >>"$LOGFILE" 2>&1 &
    echo $! > "$PIDFILE"
    sleep 1
    echo "ADVANCED_DRL_RUNNING PID=$(cat "$PIDFILE")"
    ;;
  stop)
    if [ -f "$PIDFILE" ]; then
      kill "$(cat "$PIDFILE")" 2>/dev/null || true
      rm -f "$PIDFILE"
    fi
    echo "ADVANCED_DRL_STOPPED"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    python -m companyos.runtime.advanced_drl_controller status
    if [ -f "$PIDFILE" ]; then
      echo "PID=$(cat "$PIDFILE")"
      ps -p "$(cat "$PIDFILE")" -o pid,etime,args || true
    fi
    ;;
  observe) python -m companyos.runtime.advanced_drl_controller observe ;;
  recommend) python -m companyos.runtime.advanced_drl_controller recommend ;;
  train) python -m companyos.runtime.advanced_drl_controller train --steps "${2:-50}" ;;
  bootstrap) python -m companyos.runtime.advanced_drl_controller bootstrap --limit "${2:-500}" ;;
  log) tail -n "${2:-120}" "$LOGFILE" ;;
  *)
    echo "usage: $0 {start|stop|restart|status|observe|recommend|train [steps]|bootstrap [limit]|log [lines]}"
    exit 2
    ;;
esac
