#!/usr/bin/env python3

import json
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT_DIR))

from agents.strategy_feedback_agent import (
    build_goal_progress,
    run_strategy_feedback_cycle,
    status,
)


def main() -> int:
    command = (
        sys.argv[1].strip().lower()
        if len(sys.argv) > 1
        else "status"
    )

    if command == "status":
        result = status()

    elif command in {
        "run",
        "review",
    }:
        result = run_strategy_feedback_cycle()

    elif command == "goals":
        result = build_goal_progress()

    else:
        raise SystemExit(
            "Usage: strategyfeedbackctl "
            "{status|run|goals}"
        )

    print(json.dumps(result, indent=2))

    return (
        0
        if result.get("success") is not False
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(main())
