#!/usr/bin/env python3

import importlib
from agents.authority_guard import authorize_task, record_failure, record_success
import json
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

BASE_DIR = Path(__file__).resolve().parent.parent
MEMORY_DIR = BASE_DIR / "ceo_memory"

TASKS_FILE = MEMORY_DIR / "tasks.json"
RESULTS_FILE = MEMORY_DIR / "agent_results.json"

AGENT_MODULES = {
    "revenue_engine_agent": "agents.revenue_engine_agent",
    "portfolio_manager": "agents.portfolio_manager",
    "portfolio_execution_planner": "agents.portfolio_execution_planner",
    "autonomous_business_pipeline": "agents.autonomous_business_pipeline",
    "opportunity_factory_handoff": "agents.opportunity_factory_handoff",
    "opportunity_validation_agent": "agents.opportunity_validation_agent",
    "ceo_worker_agent": "agents.ceo_worker_agent",
    "research_agent": "agents.research_agent",
    "builder_agent": "agents.builder_agent",
    "finance_agent": "agents.finance_agent",
    "auditor_agent": "agents.auditor_agent",
    "marketing_agent": "agents.marketing_agent",
}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def load_json(path: Path, default: Any) -> Any:
    try:
        with path.open("r", encoding="utf-8") as file:
            return json.load(file)
    except (FileNotFoundError, json.JSONDecodeError):
        return default


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")

    with temporary.open("w", encoding="utf-8") as file:
        json.dump(data, file, indent=2)

    temporary.replace(path)


def create_task(
    agent: str,
    action: str,
    payload: dict[str, Any] | None = None,
    project_id: str | None = None,
    priority: int = 5,
) -> dict[str, Any]:
    if agent not in AGENT_MODULES:
        raise ValueError(f"Unknown agent: {agent}")

    task = {
        "id": f"task-{uuid.uuid4().hex[:10]}",
        "agent": agent,
        "action": action,
        "payload": payload or {},
        "project_id": project_id,
        "priority": priority,
        "status": "pending",
        "attempts": 0,
        "created_at": now(),
        "started_at": None,
        "completed_at": None,
        "error": None,
    }

    tasks = load_json(TASKS_FILE, [])
    tasks.append(task)

    tasks.sort(
        key=lambda item: (
            item.get("status") != "pending",
            item.get("priority", 5),
            item.get("created_at", ""),
        )
    )

    save_json(TASKS_FILE, tasks)
    return task


def get_next_task() -> dict[str, Any] | None:
    tasks = load_json(TASKS_FILE, [])

    pending = [
        task
        for task in tasks
        if task.get("status") == "pending"
    ]

    if not pending:
        return None

    pending.sort(
        key=lambda task: (
            task.get("priority", 5),
            task.get("created_at", ""),
        )
    )

    return pending[0]


def update_task(task_id: str, updates: dict[str, Any]) -> None:
    tasks = load_json(TASKS_FILE, [])

    for task in tasks:
        if task.get("id") == task_id:
            task.update(updates)
            break

    save_json(TASKS_FILE, tasks)


def dispatch_task(task: dict[str, Any]) -> dict[str, Any]:
    # PHASE10_STEP4B_MANAGER_GUARD
    authority = authorize_task(task)

    if authority.get("allowed") is not True:
        task_id = task.get("id")

        try:
            update_task(
                task_id,
                {
                    "status": "pending",
                    "authority_blocked": True,
                    "authority_reason": authority.get("reason"),
                    "updated_at": now(),
                },
            )
        except Exception:
            pass

        return {
            "task_id": task_id,
            "agent": task.get("agent"),
            "success": False,
            "status": "authority_blocked",
            "retryable": True,
            "error": authority.get("reason"),
            "authority": authority,
        }


    task_id = task["id"]
    agent_name = task["agent"]

    update_task(
        task_id,
        {
            "status": "running",
            "started_at": now(),
            "attempts": int(task.get("attempts", 0)) + 1,
        },
    )

    try:
        module_name = AGENT_MODULES.get(
            agent_name,
            f"agents.{agent_name}",
        )
        module = importlib.import_module(module_name)

        if not hasattr(module, "run_task"):
            raise RuntimeError(
                f"{agent_name} does not define run_task(task)"
            )

        result = module.run_task(task)

        if not isinstance(result, dict):
            raise TypeError(
                f"{agent_name} returned {type(result).__name__}; expected dict"
            )

        record = {
            "task_id": task_id,
            "agent": agent_name,
            "project_id": task.get("project_id"),
            "success": bool(result.get("success")),
            "result": result,
            "completed_at": now(),
        }

        results = load_json(RESULTS_FILE, [])
        results.append(record)
        save_json(RESULTS_FILE, results)

        update_task(
            task_id,
            {
                "status": (
                    "completed"
                    if record["success"]
                    else "failed"
                ),
                "completed_at": record["completed_at"],
                "result": result,
                "error": result.get("error"),
                "last_error": result.get("error"),
                "updated_at": now(),
            },
        )

        # PHASE10_STEP4B_MANAGER_SUCCESS
        try:
            classification = authority.get("classification", {})
            record_success(
                spending_usd=classification.get("spending_usd", 0.0),
                publication=classification.get("publication", False),
                customer_message=classification.get("customer_message", False),
            )
        except Exception:
            pass

        return record

    except Exception as error:
        update_task(
            task_id,
            {
                "status": "failed",
                "completed_at": now(),
                "error": str(error),
            },
        )

        record = {
            "task_id": task_id,
            "agent": agent_name,
            "project_id": task.get("project_id"),
            "success": False,
            "result": {
                "success": False,
                "error": str(error),
            },
            "completed_at": now(),
        }

        results = load_json(RESULTS_FILE, [])
        results.append(record)
        save_json(RESULTS_FILE, results)

        return record


def run_one_task() -> dict[str, Any]:
    task = get_next_task()

    if task is None:
        return {
            "success": True,
            "status": "idle",
            "message": "No pending tasks",
        }

    return dispatch_task(task)


if __name__ == "__main__":
    result = run_one_task()
    print(json.dumps(result, indent=2))
