#!/usr/bin/env python3

import argparse
import json
import os
import subprocess
import sys
import time
import traceback
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Callable

ROOT_DIR = Path(__file__).resolve().parent.parent
MEMORY_DIR = ROOT_DIR / "ceo_memory"
LOG_DIR = ROOT_DIR / "logs"

STATE_FILE = MEMORY_DIR / "autopilot_state.json"
HISTORY_FILE = MEMORY_DIR / "autopilot_history.json"
PID_FILE = MEMORY_DIR / "autopilot.pid"
LOG_FILE = LOG_DIR / "autonomous_ceo.log"

sys.path.insert(0, str(ROOT_DIR))

from agents.authority_guard import (  # noqa: E402
    execution_mode_allows_work,
    get_state,
    record_failure,
)

from agents.post_launch_runner import (  # noqa: E402
    review_launched_ventures,
)

from agents.ceo_task_planner import (  # noqa: E402
    plan_internal_tasks,
)

from agents.ceo_internal_dispatcher import (  # noqa: E402
    dispatch_planned_tasks,
    sync_internal_results,
)

from agents.autonomous_business_pipeline import (  # noqa: E402
    run_business_pipeline,
)

from agents.portfolio_manager import (  # noqa: E402
    run_portfolio_cycle,
)

from agents.revenue_sync_agent import (  # noqa: E402
    sync_revenue_events,
)

from agents.budget_allocation_agent import (  # noqa: E402
    build_budget_plan,
)

from agents.financial_decision_agent import (  # noqa: E402
    run_financial_decision_cycle,
)

from agents.executive_strategy_agent import (  # noqa: E402
    run_executive_strategy_cycle,
)








def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return default


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(data, indent=2),
        encoding="utf-8",
    )
    temporary.replace(path)


def log(message: str) -> None:
    LOG_DIR.mkdir(parents=True, exist_ok=True)

    line = f"[{now()}] {message}"

    with LOG_FILE.open("a", encoding="utf-8") as file:
        file.write(line + "\n")

    print(line, flush=True)


def run_command(
    name: str,
    command: list[str],
    timeout: int = 180,
) -> dict[str, Any]:
    started = now()

    try:
        result = subprocess.run(
            command,
            cwd=ROOT_DIR,
            capture_output=True,
            text=True,
            timeout=timeout,
        )

        output = (
            (result.stdout or "")
            + ("\n" if result.stdout and result.stderr else "")
            + (result.stderr or "")
        ).strip()

        return {
            "success": result.returncode == 0,
            "name": name,
            "return_code": result.returncode,
            "started_at": started,
            "completed_at": now(),
            "output": output[-12000:],
        }

    except subprocess.TimeoutExpired:
        return {
            "success": False,
            "name": name,
            "return_code": None,
            "started_at": started,
            "completed_at": now(),
            "error": f"Timed out after {timeout} seconds",
        }

    except Exception as error:
        return {
            "success": False,
            "name": name,
            "return_code": None,
            "started_at": started,
            "completed_at": now(),
            "error": str(error),
        }


def run_function(
    name: str,
    function: Callable[[], dict[str, Any]],
) -> dict[str, Any]:
    started = now()

    try:
        result = function()

        if not isinstance(result, dict):
            result = {
                "success": False,
                "error": (
                    f"{name} returned "
                    f"{type(result).__name__}, expected dict"
                ),
            }

        return {
            "name": name,
            "started_at": started,
            "completed_at": now(),
            "result": result,
            "success": result.get("success") is not False,
        }

    except Exception as error:
        return {
            "name": name,
            "started_at": started,
            "completed_at": now(),
            "success": False,
            "error": str(error),
            "traceback": traceback.format_exc(),
        }


def scheduler_cycle() -> dict[str, Any]:
    return run_command(
        "global_scheduler",
        [
            sys.executable,
            str(ROOT_DIR / "companyos" / "schedulerctl"),
            "run",
            "--rounds",
            "4",
        ],
    )


def company_cycle() -> dict[str, Any]:
    return run_command(
        "company_cycle",
        [
            sys.executable,
            str(ROOT_DIR / "company_cycle.py"),
        ],
    )


def manager_cycle() -> dict[str, Any]:
    return run_command(
        "worker_manager",
        [
            sys.executable,
            "-m",
            "agents.manager",
        ],
    )


def summarize_step(step: dict[str, Any]) -> bool:
    if step.get("success") is False:
        return False

    result = step.get("result")

    if isinstance(result, dict):
        return result.get("success") is not False

    return True


def append_history(report: dict[str, Any]) -> None:
    history = load_json(HISTORY_FILE, [])

    if not isinstance(history, list):
        history = []

    history.append(report)
    save_json(HISTORY_FILE, history[-5000:])


def run_ceo_cycle() -> dict[str, Any]:
    cycle_id = f"autopilot-{uuid.uuid4().hex[:12]}"
    started_at = now()

    authority = execution_mode_allows_work()

    if authority.get("allowed") is not True:
        return {
            "success": True,
            "status": "autopilot_frozen",
            "cycle_id": cycle_id,
            "started_at": started_at,
            "completed_at": now(),
            "authority": authority,
            "steps": [],
        }

    steps: list[dict[str, Any]] = []

    # PHASE11_STEP4_BUSINESS_PIPELINE
    steps.append(run_function(
        "autonomous_business_pipeline",
        run_business_pipeline,
    ))

    # PHASE12_STEP4_PORTFOLIO_MANAGER
    steps.append(run_function(
        "autonomous_portfolio_manager",
        run_portfolio_cycle,
    ))

    # PHASE13_STEP2_REVENUE_SYNC
    steps.append(run_function(
        "automatic_revenue_sync",
        sync_revenue_events,
    ))

    # PHASE13_STEP3_BUDGET_PLANNER
    steps.append(run_function(
        "automatic_budget_planning",
        build_budget_plan,
    ))

    # PHASE13_STEP4_FINANCIAL_DECISION_ENGINE
    steps.append(run_function(
        "automatic_financial_decisions",
        run_financial_decision_cycle,
    ))

    # PHASE13_STEP5_EXECUTIVE_STRATEGY
    steps.append(run_function(
        "executive_strategy_review",
        run_executive_strategy_cycle,
    ))







    steps.append(company_cycle())
    steps.append(scheduler_cycle())
    steps.append(manager_cycle())

    steps.append(run_function(
        "post_launch_review",
        review_launched_ventures,
    ))

    steps.append(run_function(
        "internal_task_planning",
        plan_internal_tasks,
    ))

    steps.append(run_function(
        "internal_task_dispatch",
        dispatch_planned_tasks,
    ))

    steps.append(manager_cycle())

    steps.append(run_function(
        "internal_result_sync",
        sync_internal_results,
    ))

    steps.append(scheduler_cycle())

    failures = [
        step
        for step in steps
        if not summarize_step(step)
    ]

    report = {
        "success": len(failures) == 0,
        "status": (
            "autopilot_cycle_complete"
            if not failures
            else "autopilot_cycle_completed_with_failures"
        ),
        "cycle_id": cycle_id,
        "started_at": started_at,
        "completed_at": now(),
        "step_count": len(steps),
        "failure_count": len(failures),
        "steps": steps,
        "authority_state": get_state(),
    }

    append_history(report)

    state = {
        "running": True,
        "pid": os.getpid(),
        "last_cycle_id": cycle_id,
        "last_cycle_started_at": started_at,
        "last_cycle_completed_at": report["completed_at"],
        "last_cycle_success": report["success"],
        "last_failure_count": len(failures),
        "updated_at": now(),
    }

    save_json(STATE_FILE, state)

    if failures:
        for failure in failures:
            record_failure(
                failure.get("name", "autopilot_step"),
                (
                    failure.get("error")
                    or failure.get("output")
                    or "Autopilot step failed"
                )[-1000:],
            )

    return report


def run_loop(delay: int) -> None:
    delay = max(30, int(delay))

    MEMORY_DIR.mkdir(parents=True, exist_ok=True)
    LOG_DIR.mkdir(parents=True, exist_ok=True)

    PID_FILE.write_text(
        str(os.getpid()),
        encoding="utf-8",
    )

    save_json(STATE_FILE, {
        "running": True,
        "pid": os.getpid(),
        "delay_seconds": delay,
        "started_at": now(),
        "updated_at": now(),
    })

    log(
        f"Autonomous CEO loop started "
        f"with delay={delay} seconds"
    )

    try:
        while True:
            authority = execution_mode_allows_work()

            if authority.get("mode") == "stop":
                log("Authority mode is stop. Exiting loop.")
                break

            if authority.get("allowed") is not True:
                log(
                    "Autopilot frozen: "
                    f"{authority.get('reason')}"
                )
                time.sleep(min(delay, 60))
                continue

            report = run_ceo_cycle()

            log(
                f"Cycle {report.get('cycle_id')} finished; "
                f"success={report.get('success')}; "
                f"failures={report.get('failure_count', 0)}"
            )

            time.sleep(delay)

    except KeyboardInterrupt:
        log("Autonomous CEO loop stopped by keyboard interrupt.")

    finally:
        state = load_json(STATE_FILE, {})
        if not isinstance(state, dict):
            state = {}

        state["running"] = False
        state["stopped_at"] = now()
        state["updated_at"] = now()

        save_json(STATE_FILE, state)

        try:
            PID_FILE.unlink()
        except FileNotFoundError:
            pass

        log("Autonomous CEO loop exited safely.")


def status() -> dict[str, Any]:
    state = load_json(STATE_FILE, {})

    pid = None

    try:
        pid = int(PID_FILE.read_text(encoding="utf-8").strip())
    except (FileNotFoundError, ValueError, OSError):
        pass

    process_alive = False

    if pid:
        try:
            os.kill(pid, 0)
            process_alive = True
        except (ProcessLookupError, PermissionError):
            process_alive = False

    return {
        "success": True,
        "status": "autopilot_status",
        "process_alive": process_alive,
        "pid": pid,
        "authority": execution_mode_allows_work(),
        "state": state,
        "log_file": str(LOG_FILE),
        "history_file": str(HISTORY_FILE),
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command",
        choices=["once", "loop", "status"],
    )
    parser.add_argument(
        "--delay",
        type=int,
        default=300,
    )

    args = parser.parse_args()

    if args.command == "once":
        print(json.dumps(
            run_ceo_cycle(),
            indent=2,
        ))
        return 0

    if args.command == "loop":
        run_loop(args.delay)
        return 0

    print(json.dumps(status(), indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
