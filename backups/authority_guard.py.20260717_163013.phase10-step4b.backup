#!/usr/bin/env python3

import json
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

ROOT_DIR = Path(__file__).resolve().parent.parent
MEMORY_DIR = ROOT_DIR / "ceo_memory"

POLICY_FILE = MEMORY_DIR / "authority_policy.json"
STATE_FILE = MEMORY_DIR / "authority_state.json"
EVENTS_FILE = MEMORY_DIR / "authority_events.json"


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return default


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(json.dumps(data, indent=2), encoding="utf-8")
    temp.replace(path)


def clean(value: Any) -> str:
    return "" if value is None else str(value).strip()


def record_event(
    event_type: str,
    details: dict[str, Any],
) -> None:
    events = load_json(EVENTS_FILE, [])

    if not isinstance(events, list):
        events = []

    events.append({
        "event_type": event_type,
        "details": details,
        "created_at": now(),
    })

    save_json(EVENTS_FILE, events[-10000:])


def get_policy() -> dict[str, Any]:
    policy = load_json(POLICY_FILE, {})

    if not isinstance(policy, dict):
        raise RuntimeError("Authority policy is invalid")

    return policy


def get_state() -> dict[str, Any]:
    state = load_json(STATE_FILE, {})

    if not isinstance(state, dict):
        raise RuntimeError("Authority state is invalid")

    return state


def set_mode(
    mode: str,
    reason: str,
    changed_by: str = "owner",
    automatic: bool = False,
) -> dict[str, Any]:
    mode = clean(mode).lower()

    if mode not in {"operate", "freeze", "stop"}:
        raise ValueError(
            "Mode must be operate, freeze, or stop"
        )

    state = get_state()
    state["mode"] = mode
    state["reason"] = reason
    state["changed_by"] = changed_by
    state["changed_at"] = now()
    state["automatic_freeze"] = bool(automatic)

    save_json(STATE_FILE, state)

    record_event(
        "authority_mode_changed",
        {
            "mode": mode,
            "reason": reason,
            "changed_by": changed_by,
            "automatic": automatic,
        },
    )

    return state


def freeze(
    reason: str,
    automatic: bool = True,
) -> dict[str, Any]:
    return set_mode(
        "freeze",
        reason,
        changed_by=(
            "authority_guard"
            if automatic
            else "owner"
        ),
        automatic=automatic,
    )


def action_allowed(
    action: str,
    *,
    external: bool = False,
    customer_message: bool = False,
    spending_usd: float = 0.0,
    connector_id: str = "",
    shell_command: bool = False,
    self_modification: bool = False,
) -> dict[str, Any]:
    policy = get_policy()
    state = get_state()

    action_name = clean(action).lower()
    mode = clean(state.get("mode")).lower()

    decision = {
        "allowed": False,
        "action": action_name,
        "mode": mode,
        "reason": "",
    }

    if mode != "operate":
        decision["reason"] = (
            f"Authority mode is {mode}"
        )
        return decision

    blocked_patterns = policy.get(
        "blocked_action_patterns",
        [],
    )

    for pattern in blocked_patterns:
        if clean(pattern).lower() in action_name:
            decision["reason"] = (
                f"Action matches blocked pattern: {pattern}"
            )
            return decision

    if shell_command and not policy.get(
        "code_execution",
        {},
    ).get("allow_shell_commands", False):
        decision["reason"] = (
            "Arbitrary shell execution is disabled"
        )
        return decision

    if self_modification and not policy.get(
        "code_execution",
        {},
    ).get("allow_self_modification", False):
        decision["reason"] = (
            "Self-modification is disabled"
        )
        return decision

    if external:
        if not policy.get(
            "autonomous_external_publication",
            False,
        ):
            decision["reason"] = (
                "Autonomous external actions are disabled"
            )
            return decision

        allowed_connectors = policy.get(
            "allowed_connectors",
            [],
        )

        if (
            connector_id
            and connector_id not in allowed_connectors
        ):
            decision["reason"] = (
                f"Connector is not allowed: {connector_id}"
            )
            return decision

        maximum = int(
            policy.get(
                "publication_limits",
                {},
            ).get(
                "maximum_publications_per_day",
                0,
            )
            or 0
        )

        if int(
            state.get("daily_publications", 0)
            or 0
        ) >= maximum:
            freeze(
                "Daily publication limit reached"
            )
            decision["reason"] = (
                "Daily publication limit reached"
            )
            return decision

    if customer_message:
        if not policy.get(
            "autonomous_customer_messages",
            False,
        ):
            decision["reason"] = (
                "Autonomous customer messages are disabled"
            )
            return decision

        maximum = int(
            policy.get(
                "communication_limits",
                {},
            ).get(
                "maximum_customer_messages_per_day",
                0,
            )
            or 0
        )

        if int(
            state.get(
                "daily_customer_messages",
                0,
            )
            or 0
        ) >= maximum:
            freeze(
                "Daily customer-message limit reached"
            )
            decision["reason"] = (
                "Daily customer-message limit reached"
            )
            return decision

    spending = max(0.0, float(spending_usd or 0.0))

    if spending > 0:
        if not policy.get(
            "autonomous_spending",
            False,
        ):
            decision["reason"] = (
                "Autonomous spending is disabled"
            )
            return decision

        limits = policy.get(
            "spending_limits",
            {},
        )

        single_limit = float(
            limits.get(
                "maximum_single_transaction_usd",
                0,
            )
            or 0
        )

        daily_limit = float(
            limits.get(
                "maximum_daily_total_usd",
                0,
            )
            or 0
        )

        monthly_limit = float(
            limits.get(
                "maximum_monthly_total_usd",
                0,
            )
            or 0
        )

        if spending > single_limit:
            freeze(
                "Single-transaction limit exceeded"
            )
            decision["reason"] = (
                "Single-transaction limit exceeded"
            )
            return decision

        if (
            float(
                state.get(
                    "daily_spending_usd",
                    0,
                )
                or 0
            )
            + spending
            > daily_limit
        ):
            freeze(
                "Daily spending limit exceeded"
            )
            decision["reason"] = (
                "Daily spending limit exceeded"
            )
            return decision

        if (
            float(
                state.get(
                    "monthly_spending_usd",
                    0,
                )
                or 0
            )
            + spending
            > monthly_limit
        ):
            freeze(
                "Monthly spending limit exceeded"
            )
            decision["reason"] = (
                "Monthly spending limit exceeded"
            )
            return decision

    decision["allowed"] = True
    decision["reason"] = (
        "Action is permitted by current policy"
    )

    return decision


def record_success(
    *,
    spending_usd: float = 0.0,
    publication: bool = False,
    customer_message: bool = False,
) -> dict[str, Any]:
    state = get_state()

    spending = max(
        0.0,
        float(spending_usd or 0.0),
    )

    state["consecutive_failures"] = 0
    state["daily_spending_usd"] = round(
        float(
            state.get("daily_spending_usd", 0)
            or 0
        )
        + spending,
        2,
    )
    state["monthly_spending_usd"] = round(
        float(
            state.get("monthly_spending_usd", 0)
            or 0
        )
        + spending,
        2,
    )

    if publication:
        state["daily_publications"] = int(
            state.get("daily_publications", 0)
            or 0
        ) + 1

    if customer_message:
        state["daily_customer_messages"] = int(
            state.get(
                "daily_customer_messages",
                0,
            )
            or 0
        ) + 1

    save_json(STATE_FILE, state)
    return state


def record_failure(
    action: str,
    error: str,
) -> dict[str, Any]:
    policy = get_policy()
    state = get_state()

    state["consecutive_failures"] = int(
        state.get("consecutive_failures", 0)
        or 0
    ) + 1

    state["failed_actions_this_hour"] = int(
        state.get("failed_actions_this_hour", 0)
        or 0
    ) + 1

    save_json(STATE_FILE, state)

    record_event(
        "authority_action_failed",
        {
            "action": action,
            "error": error,
            "consecutive_failures": state[
                "consecutive_failures"
            ],
            "failed_actions_this_hour": state[
                "failed_actions_this_hour"
            ],
        },
    )

    limits = policy.get("failure_limits", {})

    if state["consecutive_failures"] >= int(
        limits.get(
            "maximum_consecutive_failures",
            3,
        )
        or 3
    ):
        return freeze(
            "Maximum consecutive failures reached"
        )

    if state["failed_actions_this_hour"] >= int(
        limits.get(
            "maximum_failed_actions_per_hour",
            6,
        )
        or 6
    ):
        return freeze(
            "Hourly failed-action limit reached"
        )

    return state


def status() -> dict[str, Any]:
    return {
        "success": True,
        "status": "authority_status",
        "policy": get_policy(),
        "state": get_state(),
    }


if __name__ == "__main__":
    print(json.dumps(status(), indent=2))
