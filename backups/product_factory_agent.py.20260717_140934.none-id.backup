#!/usr/bin/env python3

import json
import uuid
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

BASE_DIR = Path(__file__).resolve().parent.parent
MEMORY_DIR = BASE_DIR / "ceo_memory"

IDEAS_FILE = MEMORY_DIR / "ideas.json"
VENTURES_FILE = MEMORY_DIR / "ventures.json"
PROJECTS_FILE = MEMORY_DIR / "projects.json"
PRODUCTS_FILE = MEMORY_DIR / "products.json"

WORKFLOWS_FILE = MEMORY_DIR / "product_factory_workflows.json"
EVENTS_FILE = MEMORY_DIR / "product_factory_events.json"
SUMMARY_FILE = MEMORY_DIR / "product_factory_summary.json"
REPORT_DIR = MEMORY_DIR / "product_factory_reports"

PIPELINE = [
    "idea_selected",
    "research",
    "validation",
    "product_design",
    "prototype_build",
    "quality_audit",
    "publishing_preparation",
    "launch_ready",
]

STAGE_OWNERS = {
    "idea_selected": "executive_agent",
    "research": "research_agent",
    "validation": "validation_agent",
    "product_design": "builder_agent",
    "prototype_build": "builder_agent",
    "quality_audit": "auditor_agent",
    "publishing_preparation": "publisher_agent",
    "launch_ready": "executive_agent",
}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return default


def save_json(path: Path, data: Any) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)

    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(data, indent=2),
        encoding="utf-8",
    )
    temporary.replace(path)


def normalize_list(value: Any) -> list[dict[str, Any]]:
    if isinstance(value, list):
        return [
            item
            for item in value
            if isinstance(item, dict)
        ]

    if isinstance(value, dict):
        return [
            item
            for item in value.values()
            if isinstance(item, dict)
        ]

    return []


def record_event(
    workflow_id: str,
    event_type: str,
    details: dict[str, Any],
) -> None:
    events = normalize_list(
        load_json(EVENTS_FILE, [])
    )

    events.append({
        "id": f"factory-event-{uuid.uuid4().hex[:12]}",
        "workflow_id": workflow_id,
        "event_type": event_type,
        "details": details,
        "created_at": now(),
    })

    save_json(EVENTS_FILE, events[-10000:])


def idea_score(idea: dict[str, Any]) -> float:
    for key in (
        "final_score",
        "score",
        "raw_score",
        "opportunity_score",
    ):
        try:
            value = float(idea.get(key, 0) or 0)

            if value:
                return value
        except (TypeError, ValueError):
            pass

    metrics = idea.get("metrics", {})

    if isinstance(metrics, dict):
        values = []

        for value in metrics.values():
            try:
                values.append(float(value))
            except (TypeError, ValueError):
                continue

        if values:
            return sum(values) / len(values)

    return 0.0


def choose_idea(
    requested_idea_id: str | None = None,
) -> dict[str, Any] | None:
    raw_ideas = load_json(IDEAS_FILE, [])

    if isinstance(raw_ideas, list):
        ideas = [
            item
            for item in raw_ideas
            if isinstance(item, dict)
        ]

    elif isinstance(raw_ideas, dict):
        ideas = []

        for key in (
            "ideas",
            "items",
            "results",
            "opportunities",
        ):
            value = raw_ideas.get(key)

            if isinstance(value, list):
                ideas.extend(
                    item
                    for item in value
                    if isinstance(item, dict)
                )

        if not ideas:
            ideas = [
                item
                for item in raw_ideas.values()
                if isinstance(item, dict)
            ]

    else:
        ideas = []

    if requested_idea_id:
        return next(
            (
                idea
                for idea in ideas
                if str(idea.get("id", "")).strip()
                == requested_idea_id
            ),
            None,
        )

    blocked_statuses = {
        "rejected",
        "archived",
        "launched",
        "completed",
        "cancelled",
        "closed",
    }

    eligible = [
        idea
        for idea in ideas
        if str(idea.get("id", "")).strip()
        and str(
            idea.get("status", "unvalidated")
        ).strip().lower()
        not in blocked_statuses
    ]

    if not eligible:
        return None

    status_priority = {
        "validated": 5,
        "approved": 5,
        "incubating": 4,
        "scored": 4,
        "researched": 3,
        "unvalidated": 2,
        "new": 1,
    }

    eligible.sort(
        key=lambda idea: (
            status_priority.get(
                str(
                    idea.get(
                        "status",
                        "unvalidated",
                    )
                ).strip().lower(),
                0,
            ),
            idea_score(idea),
        ),
        reverse=True,
    )

    return eligible[0]


def active_workflow_for_idea(
    idea_id: str,
    workflows: list[dict[str, Any]],
) -> dict[str, Any] | None:
    return next(
        (
            workflow
            for workflow in workflows
            if str(workflow.get("idea_id", ""))
            == idea_id
            and str(
                workflow.get("status", "")
            ).lower()
            in {
                "active",
                "paused",
                "awaiting_approval",
            }
        ),
        None,
    )


def create_workflow(
    task: dict[str, Any],
) -> dict[str, Any]:
    payload = task.get("payload", {})

    if not isinstance(payload, dict):
        payload = {}

    requested_idea_id = str(
        payload.get("idea_id", "")
    ).strip() or None

    idea = choose_idea(requested_idea_id)

    if idea is None:
        return {
            "success": False,
            "status": "no_eligible_idea",
            "error": (
                "No eligible business idea was found. "
                "Run opportunity research and scoring first."
            ),
        }

    idea_id = str(
        idea.get("id", "")
    ).strip()

    if not idea_id:
        return {
            "success": False,
            "status": "invalid_idea",
            "error": "Selected idea does not have an ID.",
        }

    workflows = normalize_list(
        load_json(WORKFLOWS_FILE, [])
    )

    existing = active_workflow_for_idea(
        idea_id,
        workflows,
    )

    if existing:
        return {
            "success": True,
            "status": "workflow_already_exists",
            "workflow": existing,
        }

    workflow_id = (
        f"factory-{uuid.uuid4().hex[:10]}"
    )

    stages = []

    for index, stage_name in enumerate(PIPELINE):
        stages.append({
            "name": stage_name,
            "position": index + 1,
            "owner": STAGE_OWNERS[stage_name],
            "status": (
                "completed"
                if stage_name == "idea_selected"
                else "waiting"
            ),
            "attempts": 0,
            "started_at": (
                now()
                if stage_name == "idea_selected"
                else None
            ),
            "completed_at": (
                now()
                if stage_name == "idea_selected"
                else None
            ),
            "result": (
                {
                    "idea_id": idea_id,
                    "idea_name": idea.get("name"),
                }
                if stage_name == "idea_selected"
                else None
            ),
        })

    stages[1]["status"] = "ready"

    workflow = {
        "id": workflow_id,
        "idea_id": idea_id,
        "idea_name": (
            idea.get("name")
            or "Unnamed business idea"
        ),
        "idea_score": round(
            idea_score(idea),
            2,
        ),
        "status": "active",
        "current_stage": "research",
        "current_stage_index": 1,
        "venture_id": None,
        "project_id": None,
        "product_id": None,
        "stages": stages,
        "automatic_internal_execution": True,
        "automatic_external_publication": False,
        "automatic_spending": False,
        "owner_approval_required_for_launch": True,
        "created_at": now(),
        "updated_at": now(),
    }

    workflows.append(workflow)
    save_json(WORKFLOWS_FILE, workflows)

    record_event(
        workflow_id,
        "workflow_created",
        {
            "idea_id": idea_id,
            "idea_name": workflow["idea_name"],
            "first_stage": "research",
        },
    )

    refresh_summary()

    return {
        "success": True,
        "status": "product_factory_workflow_created",
        "workflow": workflow,
    }


def find_workflow(
    workflow_id: str,
    workflows: list[dict[str, Any]],
) -> dict[str, Any] | None:
    return next(
        (
            workflow
            for workflow in workflows
            if str(workflow.get("id", ""))
            == workflow_id
        ),
        None,
    )


def advance_workflow(
    task: dict[str, Any],
) -> dict[str, Any]:
    payload = task.get("payload", {})

    if not isinstance(payload, dict):
        payload = {}

    workflow_id = str(
        payload.get("workflow_id", "")
    ).strip()

    if not workflow_id:
        return {
            "success": False,
            "error": "workflow_id is required",
        }

    stage_result = payload.get("result", {})

    if not isinstance(stage_result, dict):
        stage_result = {
            "value": stage_result,
        }

    stage_success = bool(
        payload.get("stage_success", True)
    )

    workflows = normalize_list(
        load_json(WORKFLOWS_FILE, [])
    )

    workflow = find_workflow(
        workflow_id,
        workflows,
    )

    if workflow is None:
        return {
            "success": False,
            "error": (
                f"Workflow not found: {workflow_id}"
            ),
        }

    if workflow.get("status") != "active":
        return {
            "success": False,
            "error": (
                "Only active workflows can advance."
            ),
        }

    current_index = int(
        workflow.get("current_stage_index", 0)
        or 0
    )

    stages = workflow.get("stages", [])

    if (
        not isinstance(stages, list)
        or current_index >= len(stages)
    ):
        return {
            "success": False,
            "error": "Workflow stage data is invalid.",
        }

    current_stage = stages[current_index]
    current_stage["attempts"] = int(
        current_stage.get("attempts", 0)
        or 0
    ) + 1

    current_stage["started_at"] = (
        current_stage.get("started_at")
        or now()
    )

    if not stage_success:
        current_stage["status"] = "failed"
        current_stage["result"] = stage_result
        current_stage["completed_at"] = now()

        workflow["status"] = "paused"
        workflow["failure_stage"] = (
            current_stage.get("name")
        )
        workflow["updated_at"] = now()

        save_json(WORKFLOWS_FILE, workflows)

        record_event(
            workflow_id,
            "stage_failed",
            {
                "stage": current_stage.get("name"),
                "result": stage_result,
            },
        )

        refresh_summary()

        return {
            "success": False,
            "status": "product_factory_stage_failed",
            "workflow": workflow,
        }

    current_stage["status"] = "completed"
    current_stage["result"] = stage_result
    current_stage["completed_at"] = now()

    next_index = current_index + 1

    if next_index >= len(stages):
        workflow["status"] = "launch_ready"
        workflow["current_stage"] = "launch_ready"
        workflow["current_stage_index"] = (
            len(stages) - 1
        )
    else:
        next_stage = stages[next_index]
        next_stage["status"] = "ready"

        workflow["current_stage_index"] = next_index
        workflow["current_stage"] = (
            next_stage.get("name")
        )

        if (
            next_stage.get("name")
            == "launch_ready"
        ):
            workflow["status"] = (
                "awaiting_approval"
            )

    workflow["updated_at"] = now()

    save_json(WORKFLOWS_FILE, workflows)

    record_event(
        workflow_id,
        "stage_completed",
        {
            "completed_stage": (
                current_stage.get("name")
            ),
            "next_stage": (
                workflow.get("current_stage")
            ),
            "workflow_status": (
                workflow.get("status")
            ),
        },
    )

    refresh_summary()

    return {
        "success": True,
        "status": "product_factory_workflow_advanced",
        "workflow": workflow,
    }


def pause_workflow(
    task: dict[str, Any],
) -> dict[str, Any]:
    payload = task.get("payload", {})

    if not isinstance(payload, dict):
        payload = {}

    workflow_id = str(
        payload.get("workflow_id", "")
    ).strip()

    workflows = normalize_list(
        load_json(WORKFLOWS_FILE, [])
    )

    workflow = find_workflow(
        workflow_id,
        workflows,
    )

    if workflow is None:
        return {
            "success": False,
            "error": f"Workflow not found: {workflow_id}",
        }

    workflow["status"] = "paused"
    workflow["pause_reason"] = payload.get(
        "reason",
        "Paused manually",
    )
    workflow["updated_at"] = now()

    save_json(WORKFLOWS_FILE, workflows)

    record_event(
        workflow_id,
        "workflow_paused",
        {
            "reason": workflow["pause_reason"],
        },
    )

    refresh_summary()

    return {
        "success": True,
        "status": "product_factory_workflow_paused",
        "workflow": workflow,
    }


def resume_workflow(
    task: dict[str, Any],
) -> dict[str, Any]:
    payload = task.get("payload", {})

    if not isinstance(payload, dict):
        payload = {}

    workflow_id = str(
        payload.get("workflow_id", "")
    ).strip()

    workflows = normalize_list(
        load_json(WORKFLOWS_FILE, [])
    )

    workflow = find_workflow(
        workflow_id,
        workflows,
    )

    if workflow is None:
        return {
            "success": False,
            "error": f"Workflow not found: {workflow_id}",
        }

    workflow["status"] = "active"
    workflow.pop("pause_reason", None)
    workflow.pop("failure_stage", None)

    current_index = int(
        workflow.get("current_stage_index", 0)
        or 0
    )

    stages = workflow.get("stages", [])

    if (
        isinstance(stages, list)
        and current_index < len(stages)
    ):
        stages[current_index]["status"] = "ready"

    workflow["updated_at"] = now()

    save_json(WORKFLOWS_FILE, workflows)

    record_event(
        workflow_id,
        "workflow_resumed",
        {
            "current_stage": (
                workflow.get("current_stage")
            ),
        },
    )

    refresh_summary()

    return {
        "success": True,
        "status": "product_factory_workflow_resumed",
        "workflow": workflow,
    }


def refresh_summary() -> dict[str, Any]:
    workflows = normalize_list(
        load_json(WORKFLOWS_FILE, [])
    )

    stage_counts: dict[str, int] = {}

    for workflow in workflows:
        stage = str(
            workflow.get(
                "current_stage",
                "unknown",
            )
        )

        stage_counts[stage] = (
            stage_counts.get(stage, 0) + 1
        )

    summary = {
        "success": True,
        "status": "product_factory_summary_created",
        "updated_at": now(),
        "total_workflows": len(workflows),
        "active_workflows": sum(
            1
            for workflow in workflows
            if workflow.get("status") == "active"
        ),
        "paused_workflows": sum(
            1
            for workflow in workflows
            if workflow.get("status") == "paused"
        ),
        "awaiting_approval": sum(
            1
            for workflow in workflows
            if workflow.get("status")
            == "awaiting_approval"
        ),
        "launch_ready": sum(
            1
            for workflow in workflows
            if workflow.get("status")
            == "launch_ready"
        ),
        "stage_counts": stage_counts,
        "automatic_internal_execution": True,
        "automatic_external_publication": False,
        "automatic_spending": False,
    }

    save_json(SUMMARY_FILE, summary)

    REPORT_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    report_file = REPORT_DIR / (
        "factory_report_"
        + datetime.now(timezone.utc).strftime(
            "%Y%m%d_%H%M%S"
        )
        + ".json"
    )

    save_json(report_file, summary)

    return summary


def list_workflows() -> dict[str, Any]:
    workflows = normalize_list(
        load_json(WORKFLOWS_FILE, [])
    )

    return {
        "success": True,
        "status": "product_factory_workflows_listed",
        "count": len(workflows),
        "workflows": workflows,
    }


def factory_status() -> dict[str, Any]:
    return {
        "success": True,
        "status": "product_factory_status",
        "summary": refresh_summary(),
        "workflows": normalize_list(
            load_json(WORKFLOWS_FILE, [])
        ),
    }


def run_task(
    task: dict[str, Any],
) -> dict[str, Any]:
    action = task.get("action")

    if action in {
        "start_product_factory",
        "create_product_workflow",
    }:
        return create_workflow(task)

    if action == "advance_product_workflow":
        return advance_workflow(task)

    if action == "pause_product_workflow":
        return pause_workflow(task)

    if action == "resume_product_workflow":
        return resume_workflow(task)

    if action == "list_product_workflows":
        return list_workflows()

    if action == "product_factory_status":
        return factory_status()

    return {
        "success": False,
        "error": (
            f"Unsupported product factory action: "
            f"{action}"
        ),
    }


if __name__ == "__main__":
    print(json.dumps(
        factory_status(),
        indent=2,
    ))
