#!/usr/bin/env python3

import json
import os
import subprocess
import threading
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from typing import Any
from urllib.parse import urlparse

ROOT_DIR = Path(__file__).resolve().parent.parent.parent
MEMORY_DIR = ROOT_DIR / "ceo_memory"
COMPANYOS_DIR = ROOT_DIR / "companyos"
DASHBOARD_DIR = COMPANYOS_DIR / "dashboard"
ACTION_LOG = DASHBOARD_DIR / "logs" / "actions.log"

HOST = os.environ.get("COMPANYOS_DASHBOARD_HOST", "127.0.0.1")
PORT = int(os.environ.get("COMPANYOS_DASHBOARD_PORT", "8765"))

FILES = {
    "company_state": MEMORY_DIR / "company_state.json",
    "projects": MEMORY_DIR / "projects.json",
    "tasks": MEMORY_DIR / "tasks.json",
    "finance": MEMORY_DIR / "finance.json",
    "scores": MEMORY_DIR / "opportunity_scores.json",
    "executive": MEMORY_DIR / "executive_summary.json",
    "learning": MEMORY_DIR / "learning_summary.json",
    "performance": MEMORY_DIR / "agent_performance.json",
    "escalations": MEMORY_DIR / "escalations.json",
    "cycles": MEMORY_DIR / "company_cycles.json",
}

ALLOWED_ACTIONS = {
    "company_cycle": {
        "label": "Run company cycle",
        "command": ["python", "company_cycle.py"],
        "timeout": 300,
    },
    "recovery": {
        "label": "Run recovery scan",
        "command": ["python", "-m", "agents.recovery_agent"],
        "timeout": 180,
    },
    "executive": {
        "label": "Run executive review",
        "command": ["python", "-m", "agents.executive_agent"],
        "timeout": 180,
    },
    "scoring": {
        "label": "Run opportunity scoring",
        "command": ["python", "-m", "agents.scoring_agent"],
        "timeout": 180,
    },
    "learning": {
        "label": "Run learning cycle",
        "command": ["python", "-m", "agents.learning_agent"],
        "timeout": 240,
    },
}

ACTION_LOCK = threading.Lock()
ACTION_STATE: dict[str, Any] = {
    "running": False,
    "action": None,
    "started_at": None,
    "finished_at": None,
    "success": None,
    "message": "No dashboard action has run yet.",
}


def now() -> str:
    return datetime.now(timezone.utc).isoformat()


def load_json(path: Path, default: Any) -> Any:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return default


def normalize_list(value: Any) -> list[dict[str, Any]]:
    if isinstance(value, list):
        return [item for item in value if isinstance(item, dict)]

    if isinstance(value, dict):
        return [item for item in value.values() if isinstance(item, dict)]

    return []


def status_of(item: dict[str, Any]) -> str:
    return str(item.get("status", "unknown")).lower()


def process_running(pattern: str) -> bool:
    try:
        result = subprocess.run(
            ["pgrep", "-f", pattern],
            capture_output=True,
            text=True,
            timeout=5,
        )
        return result.returncode == 0 and bool(result.stdout.strip())
    except (OSError, subprocess.SubprocessError):
        return False


def task_summary() -> dict[str, int]:
    tasks = normalize_list(load_json(FILES["tasks"], []))

    counts = {
        "total": len(tasks),
        "pending": 0,
        "running": 0,
        "completed": 0,
        "failed": 0,
        "other": 0,
    }

    for task in tasks:
        status = status_of(task)

        if status in {"pending", "queued", "waiting"}:
            counts["pending"] += 1
        elif status == "running":
            counts["running"] += 1
        elif status in {"completed", "done", "success", "successful"}:
            counts["completed"] += 1
        elif status in {"failed", "error", "rejected"}:
            counts["failed"] += 1
        else:
            counts["other"] += 1

    return counts


def project_summary() -> dict[str, int]:
    projects = normalize_list(load_json(FILES["projects"], []))

    counts = {
        "total": len(projects),
        "active": 0,
        "completed": 0,
        "failed": 0,
    }

    for project in projects:
        status = status_of(project)

        if status in {"completed", "done", "successful"}:
            counts["completed"] += 1
        elif status in {"failed", "cancelled", "rejected"}:
            counts["failed"] += 1
        else:
            counts["active"] += 1

    return counts


def latest_cycle() -> dict[str, Any]:
    cycles = normalize_list(load_json(FILES["cycles"], []))
    return cycles[-1] if cycles else {}


def attention_departments() -> list[str]:
    executive = load_json(FILES["executive"], {})
    reports = executive.get("department_reports", {})

    if not isinstance(reports, dict):
        return []

    return [
        name
        for name, report in reports.items()
        if isinstance(report, dict)
        and report.get("health") == "attention_required"
    ]


def display_health(raw_health: str) -> str:
    labels = {
        "attention_required": "Needs review",
        "stable": "Stable",
        "active": "Active",
        "healthy": "Healthy",
        "unknown": "Unknown",
    }

    return labels.get(
        str(raw_health).lower(),
        str(raw_health).replace("_", " ").title(),
    )


def build_overview() -> dict[str, Any]:
    company = load_json(FILES["company_state"], {})
    finance = load_json(FILES["finance"], {})
    executive = load_json(FILES["executive"], {})
    learning = load_json(FILES["learning"], {})
    scores = normalize_list(load_json(FILES["scores"], []))
    escalations = normalize_list(load_json(FILES["escalations"], []))

    raw_health = str(
        executive.get("company_health", "unknown")
    )

    open_escalations = [
        item
        for item in escalations
        if status_of(item) == "open"
    ]

    return {
        "generated_at": now(),
        "company_name": company.get(
            "company_name",
            "CompanyOS",
        ),
        "company_status": company.get("status", "unknown"),
        "current_goal": company.get("current_goal", ""),
        "company_health": raw_health,
        "company_health_label": display_health(raw_health),
        "attention_departments": attention_departments(),
        "available_budget_usd": float(
            finance.get("available_budget_usd", 0) or 0
        ),
        "total_revenue_usd": float(
            finance.get("total_revenue_usd", 0) or 0
        ),
        "total_expenses_usd": float(
            finance.get("total_expenses_usd", 0) or 0
        ),
        "tasks": task_summary(),
        "projects": project_summary(),
        "open_escalations": len(open_escalations),
        "total_lessons": learning.get("total_lessons", 0),
        "top_opportunity": scores[0] if scores else None,
        "latest_cycle_success": latest_cycle().get("success"),
        "company_loop_running": process_running(
            "company_cycle.py --loop"
        ),
    }


def log_action(message: str) -> None:
    ACTION_LOG.parent.mkdir(parents=True, exist_ok=True)

    with ACTION_LOG.open("a", encoding="utf-8") as file:
        file.write(f"{now()} {message}\n")


def execute_action(action_name: str) -> None:
    global ACTION_STATE

    settings = ALLOWED_ACTIONS[action_name]

    with ACTION_LOCK:
        ACTION_STATE = {
            "running": True,
            "action": action_name,
            "started_at": now(),
            "finished_at": None,
            "success": None,
            "message": f"Running {settings['label']}...",
        }

    log_action(f"START {action_name}")

    try:
        result = subprocess.run(
            settings["command"],
            cwd=str(ROOT_DIR),
            capture_output=True,
            text=True,
            timeout=settings["timeout"],
        )

        output = (
            result.stdout.strip()
            or result.stderr.strip()
            or "Action completed without console output."
        )

        message = output[-3000:]

        with ACTION_LOCK:
            ACTION_STATE = {
                "running": False,
                "action": action_name,
                "started_at": ACTION_STATE["started_at"],
                "finished_at": now(),
                "success": result.returncode == 0,
                "message": message,
            }

        log_action(
            f"FINISH {action_name} return_code={result.returncode}"
        )

    except subprocess.TimeoutExpired:
        with ACTION_LOCK:
            ACTION_STATE = {
                "running": False,
                "action": action_name,
                "started_at": ACTION_STATE["started_at"],
                "finished_at": now(),
                "success": False,
                "message": "Action timed out.",
            }

        log_action(f"TIMEOUT {action_name}")

    except Exception as error:
        with ACTION_LOCK:
            ACTION_STATE = {
                "running": False,
                "action": action_name,
                "started_at": ACTION_STATE["started_at"],
                "finished_at": now(),
                "success": False,
                "message": str(error),
            }

        log_action(f"ERROR {action_name}: {error}")


def start_action(action_name: str) -> dict[str, Any]:
    if action_name not in ALLOWED_ACTIONS:
        return {
            "success": False,
            "error": "Unsupported dashboard action",
        }

    with ACTION_LOCK:
        if ACTION_STATE["running"]:
            return {
                "success": False,
                "error": (
                    "Another dashboard action is already running: "
                    + str(ACTION_STATE["action"])
                ),
            }

        ACTION_STATE["running"] = True
        ACTION_STATE["action"] = action_name
        ACTION_STATE["started_at"] = now()
        ACTION_STATE["message"] = "Action queued."

    thread = threading.Thread(
        target=execute_action,
        args=(action_name,),
        daemon=True,
    )
    thread.start()

    return {
        "success": True,
        "status": "action_started",
        "action": action_name,
        "label": ALLOWED_ACTIONS[action_name]["label"],
    }


def dashboard_html() -> str:
    return """<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1">
<title>CompanyOS Control Center</title>
<style>
:root {
  color-scheme: dark;
  font-family: system-ui, sans-serif;
  background: #0b0d10;
  color: #f4f6f8;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  padding: 16px;
  max-width: 1200px;
  margin-inline: auto;
}
header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}
h1, h2, h3 { margin: 0; }
small { color: #9ba4ae; }
.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
  gap: 12px;
}
.card {
  background: #15191f;
  border: 1px solid #272d35;
  border-radius: 14px;
  padding: 14px;
  overflow: hidden;
}
.value {
  font-size: clamp(1.2rem, 5vw, 1.55rem);
  font-weight: 750;
  margin-top: 6px;
  overflow-wrap: anywhere;
}
.section { margin-top: 18px; }
.controls {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(155px, 1fr));
  gap: 10px;
  margin-top: 14px;
}
button {
  background: #f4f6f8;
  color: #101317;
  border: 0;
  border-radius: 10px;
  padding: 11px 12px;
  font-weight: 750;
}
button:disabled {
  opacity: .45;
}
.good { color: #70e09b; }
.bad { color: #ff7f7f; }
.warn { color: #ffd479; }
table {
  width: 100%;
  border-collapse: collapse;
  font-size: .88rem;
}
th, td {
  text-align: left;
  padding: 9px 6px;
  border-bottom: 1px solid #2a3038;
}
pre {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  max-height: 300px;
  overflow-y: auto;
  background: #0d1014;
  padding: 12px;
  border-radius: 10px;
}
</style>
</head>
<body>
<header>
  <div>
    <h1 id="company-name">CompanyOS</h1>
    <small id="updated">Loading…</small>
  </div>
  <button onclick="refreshAll()">Refresh</button>
</header>

<div class="grid">
  <div class="card">
    <small>Company health</small>
    <div class="value" id="health">—</div>
    <small id="attention"></small>
  </div>
  <div class="card">
    <small>Loop status</small>
    <div class="value" id="loop">—</div>
  </div>
  <div class="card">
    <small>Available budget</small>
    <div class="value" id="budget">$0.00</div>
  </div>
  <div class="card">
    <small>Total revenue</small>
    <div class="value" id="revenue">$0.00</div>
  </div>
  <div class="card">
    <small>Active projects</small>
    <div class="value" id="projects">0</div>
  </div>
  <div class="card">
    <small>Pending tasks</small>
    <div class="value" id="pending">0</div>
  </div>
  <div class="card">
    <small>Completed tasks</small>
    <div class="value" id="completed">0</div>
  </div>
  <div class="card">
    <small>Open escalations</small>
    <div class="value" id="escalations">0</div>
  </div>
</div>

<div class="section card">
  <h2>Company controls</h2>
  <p>
    Only predefined local CompanyOS actions can be executed.
  </p>

  <div class="controls">
    <button class="action"
      onclick="runAction('company_cycle')">
      Run company cycle
    </button>

    <button class="action"
      onclick="runAction('executive')">
      Executive review
    </button>

    <button class="action"
      onclick="runAction('recovery')">
      Recovery scan
    </button>

    <button class="action"
      onclick="runAction('scoring')">
      Score opportunities
    </button>

    <button class="action"
      onclick="runAction('learning')">
      Learning cycle
    </button>
  </div>

  <h3 style="margin-top:18px">Latest action</h3>
  <p id="action-status">No action has run yet.</p>
  <pre id="action-output">—</pre>
</div>

<div class="section card">
  <h2>Current goal</h2>
  <p id="goal">—</p>
</div>

<div class="section card">
  <h2>Top opportunity</h2>
  <div id="opportunity">No scored opportunities yet.</div>
</div>

<div class="section card">
  <h2>Agent performance</h2>
  <div style="overflow:auto">
    <table>
      <thead>
        <tr>
          <th>Agent</th>
          <th>Results</th>
          <th>Success</th>
          <th>Rating</th>
        </tr>
      </thead>
      <tbody id="agents"></tbody>
    </table>
  </div>
</div>

<script>
const money = value =>
  new Intl.NumberFormat(
    "en-US",
    {style:"currency", currency:"USD"}
  ).format(Number(value || 0));

async function api(path, options = {}) {
  const response = await fetch(path, {
    cache: "no-store",
    ...options
  });

  const data = await response.json();

  if (!response.ok) {
    throw new Error(data.error || "Request failed");
  }

  return data;
}

function text(id, value) {
  document.getElementById(id).textContent = value;
}

function statusClass(value) {
  const v = String(value || "").toLowerCase();

  if (
    ["stable","excellent","good","completed","active","healthy"]
      .includes(v)
  ) return "good";

  if (
    ["failed","poor","attention_required","error"]
      .includes(v)
  ) return "bad";

  return "warn";
}

function buttonsDisabled(disabled) {
  document.querySelectorAll(".action").forEach(button => {
    button.disabled = disabled;
  });
}

async function refreshAction() {
  const state = await api("/api/action-status");

  buttonsDisabled(Boolean(state.running));

  text(
    "action-status",
    state.running
      ? "Running: " + state.action
      : (
          state.success === true
          ? "Last action succeeded"
          : state.success === false
          ? "Last action failed"
          : "No action has run yet"
        )
  );

  text("action-output", state.message || "—");
}

async function runAction(action) {
  buttonsDisabled(true);
  text("action-status", "Starting action...");
  text("action-output", "Please wait.");

  try {
    await api("/api/action/" + action, {
      method: "POST"
    });

    await refreshAction();
  } catch (error) {
    text("action-status", "Action could not start");
    text("action-output", error.message);
    buttonsDisabled(false);
  }
}

async function refreshAll() {
  try {
    const [overview, agents] = await Promise.all([
      api("/api/overview"),
      api("/api/performance")
    ]);

    text("company-name", overview.company_name);
    text(
      "updated",
      "Updated " +
      new Date(overview.generated_at).toLocaleString()
    );

    const health = document.getElementById("health");
    health.textContent = overview.company_health_label;
    health.className =
      "value " + statusClass(overview.company_health);

    text(
      "attention",
      overview.attention_departments.length
        ? "Departments: " +
          overview.attention_departments.join(", ")
        : ""
    );

    const loop = document.getElementById("loop");
    loop.textContent =
      overview.company_loop_running ? "Running" : "Stopped";
    loop.className =
      "value " +
      (overview.company_loop_running ? "good" : "warn");

    text("budget", money(overview.available_budget_usd));
    text("revenue", money(overview.total_revenue_usd));
    text("projects", overview.projects.active);
    text("pending", overview.tasks.pending);
    text("completed", overview.tasks.completed);
    text("escalations", overview.open_escalations);
    text("goal", overview.current_goal || "No current goal");

    const opportunity = overview.top_opportunity;

    document.getElementById("opportunity").innerHTML =
      opportunity
      ? `<h3>${opportunity.name}</h3>
         <p>Score: <b>${opportunity.final_score}</b> / 10</p>
         <p>Recommendation: ${opportunity.recommendation}</p>`
      : "No scored opportunities yet.";

    const agentBody = document.getElementById("agents");
    agentBody.innerHTML = "";

    Object.entries(agents).forEach(([name, data]) => {
      const row = document.createElement("tr");

      row.innerHTML = `
        <td>${name}</td>
        <td>${data.total_results || 0}</td>
        <td>${Math.round((data.success_rate || 0) * 100)}%</td>
        <td class="${statusClass(data.rating)}">
          ${data.rating}
        </td>
      `;

      agentBody.appendChild(row);
    });

    await refreshAction();
  } catch (error) {
    text("updated", "Dashboard error: " + error.message);
  }
}

refreshAll();
setInterval(refreshAll, 10000);
</script>
</body>
</html>
"""


class DashboardHandler(BaseHTTPRequestHandler):
    def send_json(
        self,
        data: Any,
        status: int = 200,
    ) -> None:
        payload = json.dumps(data, indent=2).encode("utf-8")

        self.send_response(status)
        self.send_header(
            "Content-Type",
            "application/json; charset=utf-8",
        )
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def send_html(self, html: str) -> None:
        payload = html.encode("utf-8")

        self.send_response(200)
        self.send_header(
            "Content-Type",
            "text/html; charset=utf-8",
        )
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def do_GET(self) -> None:
        path = urlparse(self.path).path

        if path == "/":
            self.send_html(dashboard_html())
        elif path == "/api/overview":
            self.send_json(build_overview())
        elif path == "/api/performance":
            data = load_json(FILES["performance"], {})
            self.send_json(
                data if isinstance(data, dict) else {}
            )
        elif path == "/api/action-status":
            with ACTION_LOCK:
                self.send_json(dict(ACTION_STATE))
        elif path == "/health":
            self.send_json({
                "success": True,
                "status": "dashboard_healthy",
                "time": now(),
            })
        else:
            self.send_json(
                {"success": False, "error": "Not found"},
                status=404,
            )

    def do_POST(self) -> None:
        path = urlparse(self.path).path
        prefix = "/api/action/"

        if not path.startswith(prefix):
            self.send_json(
                {"success": False, "error": "Not found"},
                status=404,
            )
            return

        action_name = path[len(prefix):]
        result = start_action(action_name)

        self.send_json(
            result,
            status=202 if result.get("success") else 409,
        )

    def log_message(
        self,
        format_string: str,
        *args: Any,
    ) -> None:
        log_path = DASHBOARD_DIR / "logs" / "access.log"
        log_path.parent.mkdir(parents=True, exist_ok=True)

        with log_path.open("a", encoding="utf-8") as file:
            file.write(
                f"{self.address_string()} "
                f"{format_string % args}\n"
            )


def main() -> None:
    server = ThreadingHTTPServer(
        (HOST, PORT),
        DashboardHandler,
    )

    print("=" * 60)
    print("CompanyOS Control Center")
    print(f"Address: http://{HOST}:{PORT}")
    print("Press Ctrl+C to stop.")
    print("=" * 60)

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nDashboard stopped.")
    finally:
        server.server_close()


if __name__ == "__main__":
    main()
