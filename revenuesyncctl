#!/usr/bin/env python3

import json
import sys
from pathlib import Path

ROOT_DIR = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT_DIR))

from agents.revenue_sync_agent import (
    status,
    sync_revenue_events,
)


def main() -> int:
    command = (
        sys.argv[1].strip().lower()
        if len(sys.argv) > 1
        else "status"
    )

    if command == "status":
        result = status()

    elif command == "sync":
        result = sync_revenue_events()

    elif command == "test":
        result = sync_revenue_events(
            ignore_authority=True
        )

    else:
        raise SystemExit(
            "Usage: revenuesyncctl {status|sync|test}"
        )

    print(json.dumps(result, indent=2))

    return (
        0
        if result.get("success") is not False
        else 1
    )


if __name__ == "__main__":
    raise SystemExit(main())
